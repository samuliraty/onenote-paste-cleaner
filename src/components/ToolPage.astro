---
import Base from '../layouts/Base.astro';
import Tool from './Tool.astro';
import AdSlot from './AdSlot.astro';
import { site } from '../config/site';
interface Props { title: string; description: string; h1: string; lead: string; source: string; faqs: [string, string][] }
const { title, description, h1, lead, source, faqs } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', name: title, url: new URL(Astro.url.pathname, site.url).href, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0' } },
    { '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="wrap hero">
    <h1 class="h1 disp">{h1}</h1>
    <p class="lead muted">{lead}</p>
    <p class="stat"><span class="dot"></span>Runs in your browser — nothing is uploaded, no account or login needed</p>
    <p class="note muted">Independent free tool. Not affiliated with or endorsed by Microsoft or Google; OneNote, Word, Outlook and Google Docs are trademarks of their owners.</p>
  </section>
  <div class="wrap"><AdSlot slot="leaderboard" height={90} label="leaderboard 728×90 / responsive" /></div>
  <main class="wrap grid">
    <div class="col">
      <Tool source={source} />
      <AdSlot slot="inContent" height={250} label="in-content 336×280 / responsive" class="mt" />
      <section class="prose"><slot /></section>
      <section>
        {faqs.map(([q, a]) => <div class="faq"><h3>{q}</h3><p>{a}</p></div>)}
      </section>
    </div>
    <aside class="side"><AdSlot slot="sidebar" height={600} label="sidebar 300×600" /></aside>
  </main>
</Base>
<style>
  .hero{display:flex;flex-direction:column;gap:16px;padding-top:36px;padding-bottom:28px}
  .stat{display:flex;gap:6px;align-items:center;font-size:13px;color:var(--ok);font-weight:500;margin:0}
  .note{font-size:13px;margin:0}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--ok)}
  .col{display:flex;flex-direction:column;gap:20px;min-width:0}
  .prose{padding-top:24px}
  :global(.mt){margin-top:8px}
</style>
